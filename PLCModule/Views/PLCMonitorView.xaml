<UserControl
    x:Class="PLCModule.Views.PLCMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  页面头  -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,16">
            <TextBlock Style="{StaticResource PageTitle}" Text="PLC 监控" />
            <TextBlock
                Margin="0,6,0,0"
                Style="{StaticResource MutedText}"
                Text="连接 PLC、配置通讯参数并读取信号（底层复用 PLCModule / HslCommunication）" />
        </StackPanel>

        <!--  左：配置面板  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,14,0"
            Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="PLC 配置" />

                    <TextBlock Style="{StaticResource DataLabel}" Text="IP 地址" />
                    <TextBox
                        Margin="0,6,0,14"
                        Style="{StaticResource DarkTextBox}"
                        Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource DataLabel}" Text="端口" />
                    <TextBox
                        Margin="0,6,0,14"
                        Style="{StaticResource DarkTextBox}"
                        Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource DataLabel}" Text="协议" />
                    <ComboBox
                        Margin="0,6,0,14"
                        Background="{DynamicResource SurfaceDarkBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding Protocol, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="ModbusTcp" IsSelected="True" />
                        <ComboBoxItem Content="SiemensS7" />
                        <ComboBoxItem Content="MitsubishiMC" />
                    </ComboBox>

                    <Separator Style="{StaticResource ThinSeparator}" />

                    <Button
                        Margin="0,0,0,8"
                        Command="{Binding ConnectCommand}"
                        Content="连接 PLC"
                        Style="{StaticResource PrimaryButton}" />
                    <Button
                        Margin="0,0,0,16"
                        Command="{Binding DisconnectCommand}"
                        Content="断开 PLC"
                        Style="{StaticResource DangerButton}" />

                    <Separator Style="{StaticResource ThinSeparator}" />

                    <TextBlock Style="{StaticResource DataLabel}" Text="信号地址" />
                    <TextBox
                        Margin="0,6,0,10"
                        Style="{StaticResource DarkTextBox}"
                        Text="{Binding LastSignalName, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,6,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            Grid.Column="0"
                            Background="{DynamicResource SurfaceDarkBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            ItemsSource="{Binding DataTypeOptions}"
                            SelectedItem="{Binding SelectedDataType}"
                            ToolTip="Bool 优先按线圈(功能码1)读取，从站不支持时自动退回「读寄存器、非零即真」" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0,8,0"
                            Style="{StaticResource DataLabel}"
                            Text="个数" />
                        <TextBox
                            Grid.Column="2"
                            Style="{StaticResource DarkTextBox}"
                            Text="{Binding ReadCount, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="1 = 读单个值；大于 1 = 读一组。Bool/Int16/UInt16 各占 1 个寄存器，Int32/Float 各占 2 个，Double 各占 4 个" />
                    </Grid>

                    <Button
                        Command="{Binding ReadSignalCommand}"
                        Content="读取信号"
                        Style="{StaticResource SuccessButton}" />

                    <TextBlock
                        Margin="0,16,0,0"
                        Style="{StaticResource DataLabel}"
                        Text="写入值" />
                    <TextBox
                        Margin="0,6,0,10"
                        Style="{StaticResource DarkTextBox}"
                        Text="{Binding WriteValue, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="个数 = 1 时写单个值；个数 &gt; 1 时用逗号分隔多个值（整段写连续寄存器）" />
                    <Button
                        Command="{Binding WriteCommand}"
                        Content="写入 PLC"
                        Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  右：状态面板  -->
        <StackPanel Grid.Row="1" Grid.Column="1">
            <!--  连接状态  -->
            <Border Margin="0,0,0,14" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Kind="LanConnect" />
                        <TextBlock
                            Margin="8,0,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="连接状态" />
                    </StackPanel>

                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <Ellipse
                            Width="9"
                            Height="9"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="{Binding ConnectionStatus}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource MutedText}"
                        Text="{Binding Status}" />

                    <!--  商业组件授权状态  -->
                    <Border
                        Margin="0,12,0,0"
                        Padding="10,6"
                        Background="{DynamicResource SurfaceDarkBrush}"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLicenseOk}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="{Binding LicenseStatus}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  信号读取  -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Kind="SwapHorizontal" />
                        <TextBlock
                            Margin="8,0,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="信号读取" />
                    </StackPanel>

                    <Grid Margin="0,5">
                        <TextBlock Style="{StaticResource DataLabel}" Text="地址" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontFamily="Consolas"
                            Style="{StaticResource DataValue}"
                            Text="{Binding LastSignalName}" />
                    </Grid>

                    <Border
                        Margin="0,10,0,0"
                        Padding="14"
                        Background="{DynamicResource CanvasBrush}"
                        CornerRadius="10">
                        <TextBlock
                            Padding="4"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextAccentBrush}"
                            Text="{Binding LastReadValue}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            ToolTip="{Binding LastReadValue}" />
                    </Border>

                    <!--  一次读多个时的逐值列表  -->
                    <Border
                        Margin="0,10,0,0"
                        Background="{DynamicResource SurfaceDarkBrush}"
                        CornerRadius="10"
                        MaxHeight="150"
                        Visibility="{Binding HasValues, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer Padding="10,8" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ReadValues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="0,1"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
