<UserControl
    x:Class="CustomControl.Views.LoadingUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CustomControl.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="500"
    Height="400"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource MaterialDesignLinearProgressBar}" TargetType="ProgressBar" />
    </UserControl.Resources>
    <materialDesign:Card
        Margin="15"
        Padding="25"
        Background="{DynamicResource MaterialDesignPaper}"
        Effect="{StaticResource MaterialDesignShadowDepth4}"
        UniformCornerRadius="8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Logo 图标  -->
            <materialDesign:PackIcon
                Grid.Row="0"
                Width="40"
                Height="40"
                Margin="0,5"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource PrimaryHueMidBrush}"
                Kind="CameraIris" />

            <!--  主标题  -->
            <TextBlock
                Grid.Row="1"
                Margin="0,5,0,10"
                HorizontalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Text="CCD 视觉检测系统" />

            <!--  不确定进度条  -->
            <ProgressBar
                Grid.Row="2"
                Height="6"
                Margin="0,15,0,10"
                Style="{StaticResource MaterialDesignLinearProgressBar}"
                Value="{Binding ProgressValue, Mode=OneWay}" />

            <!--  动态状态文本（可通过代码更新）  -->
            <TextBlock
                Grid.Row="3"
                Margin="0,10,0,5"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource MaterialDesignBodyLight}"
                Text="{Binding StatusMessage}" />
        </Grid>
    </materialDesign:Card>
</UserControl>
