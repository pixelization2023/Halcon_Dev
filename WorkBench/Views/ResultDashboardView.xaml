<UserControl
    x:Class="WorkBench.Views.ResultDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  页面头：标题 + 说明  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource PageTitle}" Text="结果仪表盘" />
            <TextBlock
                Margin="0,6,0,0"
                Style="{StaticResource MutedText}"
                Text="检测统计数据与历史记录" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  指标卡行：良率用渐变卡（参考 Wally），其余为普通面  -->
                <UniformGrid Margin="0,0,0,16" Columns="4" Rows="1">
                    <Border Margin="0,0,14,0" Style="{StaticResource MetricCardGradient}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextOnAccentBrush}"
                                    Kind="ChartDonut" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextOnAccentBrush}"
                                    Opacity="0.9"
                                    Text="良率" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextOnAccentBrush}"
                                Text="{Binding PassRate}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,14,0" Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Kind="Counter" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DataLabel}"
                                    Text="总检测数" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource MetricValue}"
                                Text="{Binding TotalCount}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,14,0" Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource SuccessBrush}"
                                    Kind="CheckCircleOutline" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DataLabel}"
                                    Text="合格 (OK)" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{DynamicResource SuccessBrush}"
                                Text="{Binding PassCount}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    Kind="AlertCircleOutline" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DataLabel}"
                                    Text="不合格 (NG)" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{DynamicResource ErrorBrush}"
                                Text="{Binding FailCount}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!--  图表：良率环形 + 耗时趋势（LiveCharts2）  -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="15"
                                    Height="15"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Kind="ChartDonut" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="良率分布" />
                            </StackPanel>

                            <Grid Height="150">
                                <lvc:PieChart
                                    InitialRotation="-90"
                                    LegendPosition="Hidden"
                                    Series="{Binding YieldSeries}"
                                    TooltipPosition="Hidden" />
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="{Binding PassRate}" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource MutedText}"
                                        Text="合格率" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource SuccessBrush}" />
                                    <TextBlock Style="{StaticResource DataLabel}" Text="{Binding PassCount, StringFormat=合格 {0}}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource ErrorBrush}" />
                                    <TextBlock Style="{StaticResource DataLabel}" Text="{Binding FailCount, StringFormat=不合格 {0}}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="15"
                                        Height="15"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Kind="ChartLine" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="检测耗时趋势" />
                                </StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MutedText}"
                                    Text="单位 ms" />
                            </Grid>

                            <lvc:CartesianChart
                                Height="150"
                                LegendPosition="Hidden"
                                Series="{Binding TrendSeries}"
                                TooltipPosition="Hidden"
                                XAxes="{Binding HiddenXAxes}"
                                YAxes="{Binding HiddenYAxes}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  历史记录  -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="15"
                                Height="15"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Kind="History" />
                            <TextBlock
                                Margin="8,0,0,0"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="{Binding Results.Count, StringFormat='检测记录 ({0})'}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--  数据行：判定 / 时间 / 耗时（左标签右数值风格）  -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Text="{Binding FinalJudgment}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FinalJudgment}" Value="PASS">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Text="{Binding CompletedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            Text="{Binding TotalElapsedMs, StringFormat={}{0} ms}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Style="{StaticResource ThinSeparator}" />
                        <TextBlock
                            Style="{StaticResource MutedText}"
                            Text="提示：运行流程后，每次结果会追加到这里。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
