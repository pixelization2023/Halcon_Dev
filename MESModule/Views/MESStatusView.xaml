<UserControl
    x:Class="MESModule.Views.MESStatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  页面头  -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,16">
            <TextBlock Style="{StaticResource PageTitle}" Text="MES 状态" />
            <TextBlock
                Margin="0,6,0,0"
                Style="{StaticResource MutedText}"
                Text="MES 连接、离线队列与上传统计（复用 MESModule / MESConnector）" />
        </StackPanel>

        <!--  左：MES 配置  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,14,0"
            Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="MES 配置" />

                    <TextBlock Style="{StaticResource DataLabel}" Text="服务器地址" />
                    <TextBox
                        Margin="0,6,0,14"
                        Style="{StaticResource DarkTextBox}"
                        Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource DataLabel}" Text="API Key（可选）" />
                    <TextBox
                        Margin="0,6,0,14"
                        Style="{StaticResource DarkTextBox}"
                        Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource DataLabel}" Text="产线编号" />
                    <TextBox
                        Margin="0,6,0,14"
                        Style="{StaticResource DarkTextBox}"
                        Text="{Binding LineId, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource DataLabel}" Text="工站编号" />
                    <TextBox
                        Margin="0,6,0,16"
                        Style="{StaticResource DarkTextBox}"
                        Text="{Binding StationId, UpdateSourceTrigger=PropertyChanged}" />

                    <Separator Style="{StaticResource ThinSeparator}" />

                    <Button
                        Margin="0,0,0,8"
                        Command="{Binding ConnectCommand}"
                        Content="连接 MES"
                        Style="{StaticResource PrimaryButton}" />
                    <Button
                        Margin="0,0,0,8"
                        Command="{Binding DisconnectCommand}"
                        Content="断开 MES"
                        Style="{StaticResource DangerButton}" />
                    <Button
                        Margin="0,0,0,16"
                        Command="{Binding HealthCheckCommand}"
                        Content="健康检查"
                        Style="{StaticResource ControlButton}" />

                    <Separator Style="{StaticResource ThinSeparator}" />

                    <TextBlock Style="{StaticResource DataLabel}" Text="产品条码" />
                    <TextBox
                        Margin="0,6,0,10"
                        Style="{StaticResource DarkTextBox}"
                        Text="{Binding LastBarcode, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Command="{Binding LookupCommand}"
                        Content="查询产品"
                        Style="{StaticResource SuccessButton}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  右：状态面板  -->
        <StackPanel Grid.Row="1" Grid.Column="1">
            <!--  连接状态  -->
            <Border Margin="0,0,0,14" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Kind="CloudCheckOutline" />
                        <TextBlock
                            Margin="8,0,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="连接状态" />
                    </StackPanel>

                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="{Binding ConnectionStatus}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource MutedText}"
                        Text="{Binding Status}" />
                </StackPanel>
            </Border>

            <!--  指标卡：离线队列 / 上传统计  -->
            <UniformGrid Columns="2" Rows="1">
                <Border Margin="0,0,14,0" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DataLabel}" Text="离线队列" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="{DynamicResource WarningBrush}"
                            Text="{Binding QueueCount}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource MutedText}"
                            Text="{Binding QueueStatus}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DataLabel}" Text="上传统计" />
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="成功" />
                                <TextBlock
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource SuccessBrush}"
                                    Text="{Binding TotalUploaded}" />
                            </StackPanel>
                            <StackPanel Margin="24,0,0,0">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="失败" />
                                <TextBlock
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    Text="{Binding TotalFailed}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
