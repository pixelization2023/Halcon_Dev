<UserControl
    x:Class="Inspection.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource PageTitle}" Text="权限登录" />
        <TextBlock Style="{StaticResource MutedText}" Text="迁移自原 WinForms 的权限窗体：工程师口令 666666，操作员口令 5588，管理员口令 admin888" />

        <Border Margin="0,16,0,0" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="账号" />
                <ComboBox
                    Margin="0,0,0,12"
                    ItemsSource="{Binding Accounts}"
                    SelectedItem="{Binding UserName}" />

                <TextBlock Style="{StaticResource SectionTitle}" Text="密码" />
                <TextBox
                    Margin="0,0,0,16"
                    materialDesign:HintAssist.Hint="请输入密码"
                    Style="{StaticResource DarkTextBox}"
                    Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Orientation="Horizontal">
                    <Button
                        Command="{Binding LoginCommand}"
                        Content="登录"
                        Style="{StaticResource PrimaryButton}" />
                    <Button
                        Margin="12,0,0,0"
                        Command="{Binding LogoutCommand}"
                        Content="注销"
                        Style="{StaticResource DangerButton}" />
                </StackPanel>

                <TextBlock
                    Margin="0,14,0,0"
                    FontSize="13"
                    Foreground="{DynamicResource WarningBrush}"
                    Text="{Binding Message}" />
            </StackPanel>
        </Border>

        <Border Margin="0,16,0,0" Style="{StaticResource CardBorder}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Kind="AccountCircle" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="15"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="{Binding CurrentUserText}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
