<UserControl
    x:Class="Inspection.Views.ProductView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左：产品与方案  -->
        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Style="{StaticResource PageTitle}" Text="产品方案" />

            <Border Margin="0,12,0,0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="新建产品" />
                    <TextBox
                        Margin="0,0,0,10"
                        materialDesign:HintAssist.Hint="产品名称"
                        Style="{StaticResource DarkTextBox}"
                        Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        HorizontalAlignment="Left"
                        Command="{Binding CreateProductCommand}"
                        Content="新建产品"
                        Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="产品列表" />
                    <ListBox
                        Height="160"
                        Background="{DynamicResource SurfaceDarkBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        DisplayMemberPath="."
                        ItemsSource="{Binding Products}"
                        SelectedItem="{Binding SelectedProduct}" />
                    <TextBlock
                        Margin="0,12,0,6"
                        Style="{StaticResource SectionTitle}"
                        Text="Halcon 方案文件（.hdev）" />
                    <ComboBox ItemsSource="{Binding Solutions}" SelectedItem="{Binding SelectedSolution}" />
                    <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                        <Button
                            Command="{Binding RefreshCommand}"
                            Content="刷新"
                            Style="{StaticResource ControlButton}" />
                        <Button
                            Margin="10,0,0,0"
                            Command="{Binding LoadProductCommand}"
                            Content="加载产品"
                            Style="{StaticResource SuccessButton}" />
                        <Button
                            Margin="10,0,0,0"
                            Command="{Binding SaveConfigCommand}"
                            Content="保存配置"
                            Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Text="{Binding StatusText}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!--  右：相机绑定与配置校验  -->
        <StackPanel Grid.Column="1">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="相机 / 扫码枪绑定（原 FrmSetUp 相机设置）" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox
                            Width="160"
                            ItemsSource="{Binding CameraKinds}"
                            SelectedItem="{Binding CameraKindText}" />
                        <Button
                            Margin="10,0,0,0"
                            Command="{Binding AddCameraCommand}"
                            Content="添加相机"
                            Style="{StaticResource ControlButton}" />
                    </StackPanel>

                    <DataGrid
                        Margin="0,12,0,0"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        ItemsSource="{Binding Cameras}"
                        MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Name}" Header="名称" Width="140" />
                            <DataGridTextColumn Binding="{Binding Kind}" Header="种类" Width="120" />
                            <DataGridTextColumn Binding="{Binding SerialNumber}" Header="SN 序列号" Width="*" />
                            <DataGridTextColumn Binding="{Binding Order}" Header="顺序" Width="70" />
                            <DataGridTemplateColumn Header="操作" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Command="{Binding DataContext.RemoveCameraCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="移除"
                                            Style="{StaticResource DangerButton}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="配置校验" />
                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,2"
                                    FontSize="13"
                                    Foreground="{DynamicResource WarningBrush}"
                                    Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource MutedText}"
                        Text="提示：方案文件（.hdev）需放在 产品目录 下；配置将保存为 产品名.json（原 .asol 二进制格式已不再使用）。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
