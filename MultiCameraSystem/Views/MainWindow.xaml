<Window
    x:Class="MultiCameraSystem.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    Title="CCD 视觉检测系统"
    Width="1440"
    Height="900"
    MinWidth="1120"
    MinHeight="700"
    prism:ViewModelLocator.AutoWireViewModel="True"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Window.Resources>
        <!--
            侧栏导航项：图标 + 小字，选中时主色竖条 + 淡色底（参考 Radiograph / Wally）。
            
            选中态为什么读 Button.Tag 而不是直接读 DataContext.IsSelected：
            本 Style 也被"底部固定：外观主题"那个 Button 复用，而它不在 ItemsControl
            的 ItemTemplate 里，DataContext 是 MainWindowViewModel（没有 IsSelected），
            直接绑 IsSelected 会在 VS 的"XAML 绑定失败"面板里报两条错、调试输出也会刷绑定错误。
            改为读 Tag 后：导航项由 ItemTemplate 设 Tag={Binding IsSelected}，底部按钮不设 Tag
            （null 与 True 不相等 → 不激活选中态），属性恒定存在，绑定永不失败。
        -->
        <Style x:Key="RailNavButton" TargetType="Button">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource NavRailTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10" />
                            <Border
                                x:Name="bar"
                                Width="3"
                                Height="22"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="2"
                                Visibility="Collapsed" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavRailActiveBrush}" />
                                <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavRailActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  标题栏图标开关（自定义模板，避免 MaterialDesign 把 ToggleButton 画成开关）  -->
        <Style x:Key="TitleBarToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryTintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  主题快速切换里的一个色块  -->
        <DataTemplate x:Key="ThemeSwatchTemplate">
            <Button
                Padding="10,6"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding DataContext.ApplyThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}"
                Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="swatchBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="swatchBorder" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="20"
                        Height="20"
                        Background="{Binding Primary}"
                        CornerRadius="6">
                        <Ellipse
                            Width="7"
                            Height="7"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{Binding Secondary}" />
                    </Border>
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding DisplayName}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <!--  窗体主体：近黑画布 + 大圆角（参考 Radiograph 的近黑底 + 参考 Wally 的圆角窗口）  -->
    <Border
        Background="{DynamicResource CanvasBrush}"
        BorderBrush="{DynamicResource CardBorderBrush}"
        BorderThickness="1"
        CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="26"
                Opacity="0.55"
                ShadowDepth="0"
                Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <!--  ============ 标题栏 ============  -->
            <Grid
                Grid.Row="0"
                Background="{DynamicResource SurfaceDarkBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="24"
                        Height="24"
                        Background="{DynamicResource AccentGradientBrush}"
                        CornerRadius="7">
                        <materialDesign:PackIcon
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextOnAccentBrush}"
                            Kind="CameraIris" />
                    </Border>
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="CCD 视觉检测系统" />
                    <Border
                        Width="1"
                        Height="16"
                        Margin="12,0"
                        Background="{DynamicResource BorderSubtleBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{Binding Title}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  日志面板开关  -->
                    <Button
                        Command="{Binding ToggleLogPanelCommand}"
                        Style="{StaticResource WindowButton}"
                        ToolTip="实时日志">
                        <materialDesign:PackIcon
                            Width="15"
                            Height="15"
                            Kind="Text" />
                    </Button>

                    <!--  主题快速切换  -->
                    <ToggleButton
                        x:Name="ThemeSwitcher"
                        Style="{StaticResource TitleBarToggle}"
                        ToolTip="切换主题">
                        <materialDesign:PackIcon
                            Width="15"
                            Height="15"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Kind="Palette" />
                    </ToggleButton>
                    <Popup
                        AllowsTransparency="True"
                        IsOpen="{Binding IsChecked, ElementName=ThemeSwitcher, Mode=TwoWay}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=ThemeSwitcher}"
                        StaysOpen="False">
                        <Border
                            Padding="8"
                            Background="{DynamicResource SurfaceDarkBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel MinWidth="200">
                                <TextBlock
                                    Margin="10,6,10,8"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="主色方案" />
                                <ItemsControl ItemTemplate="{StaticResource ThemeSwatchTemplate}" ItemsSource="{Binding Themes}" />
                                <Separator Style="{StaticResource ThinSeparator}" />
                                <Button
                                    Margin="2,0,2,2"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ToggleBaseThemeCommand}"
                                    Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Kind="ThemeLightDark" />
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            Text="深色 / 浅色 切换" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Margin="2,0,2,2"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding NavigateByNameCommand}"
                                    CommandParameter="ThemeSettingsView"
                                    Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Kind="TuneVariant" />
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            Text="打开外观设置…" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Border
                        Width="1"
                        Height="16"
                        Margin="6,0"
                        Background="{DynamicResource BorderSubtleBrush}" />

                    <Button
                        Click="MinimizeWindow_Click"
                        Style="{StaticResource WindowButton}"
                        ToolTip="最小化">
                        <materialDesign:PackIcon
                            Width="13"
                            Height="13"
                            Kind="WindowMinimize" />
                    </Button>
                    <Button
                        Click="MaximizeWindow_Click"
                        Style="{StaticResource WindowButton}"
                        ToolTip="最大化/还原">
                        <materialDesign:PackIcon
                            x:Name="WindowRestoreIcon"
                            Width="13"
                            Height="13"
                            Kind="WindowMaximize" />
                    </Button>
                    <Button
                        Margin="0,0,6,0"
                        Click="CloseWindow_Click"
                        Style="{StaticResource WindowCloseButton}"
                        ToolTip="关闭">
                        <materialDesign:PackIcon
                            Width="13"
                            Height="13"
                            Kind="WindowClose" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  ============ 主体：图标栏 + 内容 ============  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  左侧图标栏（深浅主题下都保持深色，参考 Wally / ZR / Radiograph）  -->
                <Border Grid.Column="0" Background="{DynamicResource NavRailBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                ItemsSource="{Binding SideNavigation}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource RailNavButton}"
                                            Tag="{Binding IsSelected}"
                                            ToolTip="{Binding Title}">
                                            <StackPanel>
                                                <Grid>
                                                    <materialDesign:PackIcon
                                                        Width="18"
                                                        Height="18"
                                                        HorizontalAlignment="Center"
                                                        Kind="{Binding Icon}" />
                                                    <!--
                                                        锁角标：当前角色进不去这个页面时显示。
                                                        注意这不是禁用按钮 —— 点上去会提示需要什么权限并弹出登录对话框。
                                                        （以前是直接把受限页从导航里删掉，现场表现就是"很多界面不见了"。）
                                                    -->
                                                    <materialDesign:PackIcon
                                                        Width="10"
                                                        Height="10"
                                                        Margin="0,-4,-11,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Foreground="{DynamicResource WarningBrush}"
                                                        Kind="Lock"
                                                        ToolTip="需要登录后使用">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLockedForCurrentRole}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </Grid>
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="9"
                                                    Text="{Binding Caption}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!--  底部固定：外观设置  -->
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,0,0,14"
                            HorizontalAlignment="Center">
                            <Separator
                                Width="36"
                                Margin="0,8"
                                Background="{DynamicResource BorderSubtleBrush}" />
                            <Button
                                Command="{Binding NavigateByNameCommand}"
                                CommandParameter="ThemeSettingsView"
                                Style="{StaticResource RailNavButton}"
                                ToolTip="外观主题">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        Kind="Palette" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="9"
                                        Text="外观" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  内容区  -->
                <ScrollViewer
                    Grid.Column="1"
                    Background="{DynamicResource CanvasBrush}"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden">
                    <ContentControl Margin="24,20,24,20" prism:RegionManager.RegionName="ContentRegion" />
                </ScrollViewer>
            </Grid>

            <!--  ============ 日志面板（可折叠）============  -->
            <Border
                x:Name="LogPanel"
                Grid.Row="2"
                Height="230"
                Background="{DynamicResource SurfaceDarkBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{Binding IsLogPanelVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Padding="14,6"
                        Background="Transparent">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Kind="Text" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="实时日志" />
                            </StackPanel>
                            <Button
                                Width="28"
                                Height="28"
                                Padding="0"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ToggleLogPanelCommand}"
                                Cursor="Hand"
                                ToolTip="关闭日志面板">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Kind="ChevronDown" />
                            </Button>
                        </Grid>
                    </Border>
                    <ContentControl Grid.Row="1" prism:RegionManager.RegionName="LogRegion" />
                </Grid>
            </Border>

            <!--  ============ 状态栏（状态胶囊）============  -->
            <Border
                Grid.Row="3"
                Padding="12,0"
                Background="{DynamicResource SurfaceDarkBrush}">
                <Grid>
                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Border Margin="0,0,8,0" Style="{StaticResource StatusChip}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Fill="{DynamicResource SuccessBrush}" Style="{StaticResource StatusDot}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="系统就绪" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatusChip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="12"
                                    Height="12"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource NavRailTextBrush}"
                                    Kind="Palette" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="{Binding ThemeDisplayName}" />
                            </StackPanel>
                        </Border>

                        <!--  操作提示：点了受限页为什么没进去（以前是静默无反应）  -->
                        <Border
                            Margin="8,0,0,0"
                            Padding="8,2"
                            Background="{DynamicResource WarningTintBrush}"
                            CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNoticeVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="12"
                                    Height="12"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource WarningBrush}"
                                    Kind="LockAlert" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="{Binding StatusNotice}" />
                            </StackPanel>
                        </Border>

                        <!--  用户胶囊：权限登录不再占一个导航页，改为从这里用对话框拉起  -->
                        <Border
                            Margin="8,0,0,0"
                            Style="{StaticResource StatusChip}"
                            ToolTip="点击登录 / 切换用户。未登录时受限页面会带锁角标，点进去会提示先登录">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="12"
                                    Height="12"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="AccountCircle">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <Button
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding LoginCommand}"
                                    Content="{Binding CurrentUserText}"
                                    Cursor="Hand"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button
                                    Margin="6,0,0,0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding LogoutCommand}"
                                    Content="注销"
                                    Cursor="Hand"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Visibility="{Binding CanLogout, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="CCD 视觉检测系统 v1.2.0" />
                        <Border
                            Width="1"
                            Height="12"
                            Margin="10,0"
                            Background="{DynamicResource BorderSubtleBrush}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="{Binding Title}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
