<UserControl
    x:Class="MultiCameraSystem.Views.ThemeSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="外观与主题" />
        <TextBlock Style="{StaticResource MutedText}" Text="参考 MaterialDesignInXamlToolkit 的 PaletteHelper 机制，主色/次色在运行期推导全部界面色；支持内置主题与自定义主色，切换后立即生效，无需重启。" />

        <!--  主题选择 + 明暗 + 预览  -->
        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="0,0,18,0"
                Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="主题（内置 + 自定义）" />

                    <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Width="196"
                                    Height="92"
                                    Margin="0,0,12,12"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand">
                                    <Border
                                        Background="{DynamicResource SurfaceDarkBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Grid.Column="0"
                                                Margin="8"
                                                Background="{Binding Primary}"
                                                CornerRadius="8">
                                                <StackPanel VerticalAlignment="Center">
                                                    <Ellipse
                                                        Width="14"
                                                        Height="14"
                                                        HorizontalAlignment="Center"
                                                        Fill="{Binding Secondary}" />
                                                </StackPanel>
                                            </Border>

                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="4,10,10,10"
                                                VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                        Text="{Binding DisplayName}" />
                                                    <Border
                                                        Margin="6,1,0,0"
                                                        Padding="4,0"
                                                        Background="{DynamicResource SecondaryTintBrush}"
                                                        CornerRadius="3"
                                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock
                                                            FontSize="9"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            Text="自定义" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    Text="{Binding Description}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Margin="0,6,0,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    Text="当前使用中"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="明暗基础主题" />
                        <ComboBox ItemsSource="{Binding BaseThemeOptions}" SelectedItem="{Binding SelectedBaseTheme}" />
                        <Button
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ToggleBaseThemeCommand}"
                            Content="深色 / 浅色 快速切换"
                            Style="{StaticResource ControlButton}" />

                        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                            <Button
                                Command="{Binding SaveCommand}"
                                Content="保存设置"
                                Style="{StaticResource SuccessButton}" />
                            <Button
                                Margin="10,0,0,0"
                                Command="{Binding ResetCommand}"
                                Content="恢复默认"
                                Style="{StaticResource ControlButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="实时预览" />

                        <Border
                            Padding="12"
                            Background="{Binding Preview[SurfaceBrush]}"
                            BorderBrush="{Binding Preview[CardBorderBrush]}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <Border
                                    Padding="10"
                                    Background="{Binding Preview[CardBrush]}"
                                    CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Preview[TextPrimaryBrush]}"
                                            Text="卡片标题" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="11"
                                            Foreground="{Binding Preview[TextSecondaryBrush]}"
                                            Text="次要说明文字" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="11"
                                            Foreground="{Binding Preview[TextMutedBrush]}"
                                            Text="弱化提示文字" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <Border
                                        Width="26"
                                        Height="26"
                                        Background="{Binding Preview[PrimaryBrush]}"
                                        CornerRadius="6" />
                                    <Border
                                        Width="26"
                                        Height="26"
                                        Margin="8,0,0,0"
                                        Background="{Binding Preview[AccentBrush]}"
                                        CornerRadius="6" />
                                    <Border
                                        Width="26"
                                        Height="26"
                                        Margin="8,0,0,0"
                                        Background="{Binding Preview[SuccessBrush]}"
                                        CornerRadius="6" />
                                    <Border
                                        Width="26"
                                        Height="26"
                                        Margin="8,0,0,0"
                                        Background="{Binding Preview[WarningBrush]}"
                                        CornerRadius="6" />
                                    <Border
                                        Width="26"
                                        Height="26"
                                        Margin="8,0,0,0"
                                        Background="{Binding Preview[ErrorBrush]}"
                                        CornerRadius="6" />
                                </StackPanel>

                                <Border
                                    Margin="0,10,0,0"
                                    Padding="8"
                                    Background="{Binding Preview[CanvasBrush]}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{Binding Preview[TextAccentBrush]}"
                                        Text="画布 / 强调文字" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!--  自定义主题  -->
        <Border Margin="0,18,0,0" Style="{StaticResource CardBorder}">
            <StackPanel>
                <Grid>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="自定义主题" />
                    <Button
                        HorizontalAlignment="Right"
                        Command="{Binding NewCustomThemeCommand}"
                        Content="新建自定义主题"
                        Style="{StaticResource ControlButton}" />
                </Grid>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource MutedText}"
                        Text="主题名称" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,20,8"
                        materialDesign:HintAssist.Hint="例如：三号机台"
                        Style="{StaticResource DarkTextBox}"
                        Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource MutedText}"
                        Text="快捷主色" />
                    <ItemsControl
                        Grid.Row="0"
                        Grid.Column="3"
                        ItemsSource="{Binding PresetColors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,6,6"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.ApplyPresetColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand"
                                    ToolTip="{Binding}">
                                    <Border Background="{Binding}" CornerRadius="4" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  取色器  -->
                    <Border
                        Grid.Column="0"
                        Margin="0,0,14,0"
                        Padding="12"
                        Background="{DynamicResource SurfaceDarkBrush}"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="主色" />
                            <materialDesign:ColorPicker
                                Height="220"
                                Margin="0,8,0,0"
                                Color="{Binding EditPrimary, Converter={StaticResource HexColor}}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="{Binding EditPrimary}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Margin="0,0,14,0"
                        Padding="12"
                        Background="{DynamicResource SurfaceDarkBrush}"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="次色 / 强调色" />
                            <materialDesign:ColorPicker
                                Height="220"
                                Margin="0,8,0,0"
                                Color="{Binding EditSecondary, Converter={StaticResource HexColor}}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="{Binding EditSecondary}" />
                        </StackPanel>
                    </Border>

                    <!--  自定义实时预览  -->
                    <Border
                        Grid.Column="2"
                        Padding="12"
                        Background="{Binding CustomPreview[SurfaceBrush]}"
                        BorderBrush="{Binding CustomPreview[CardBorderBrush]}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{Binding CustomPreview[TextPrimaryBrush]}"
                                Text="自定义预览" />

                            <Border
                                Margin="0,10,0,0"
                                Padding="10"
                                Background="{Binding CustomPreview[CardBrush]}"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{Binding CustomPreview[TextPrimaryBrush]}"
                                        Text="正文 TextPrimary" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="{Binding CustomPreview[TextSecondaryBrush]}"
                                        Text="次要 TextSecondary" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="{Binding CustomPreview[TextMutedBrush]}"
                                        Text="弱化 TextMuted" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Border
                                    Width="24"
                                    Height="24"
                                    Background="{Binding CustomPreview[PrimaryBrush]}"
                                    CornerRadius="5" />
                                <Border
                                    Width="24"
                                    Height="24"
                                    Margin="6,0,0,0"
                                    Background="{Binding CustomPreview[AccentBrush]}"
                                    CornerRadius="5" />
                                <Border
                                    Width="24"
                                    Height="24"
                                    Margin="6,0,0,0"
                                    Background="{Binding CustomPreview[SuccessBrush]}"
                                    CornerRadius="5" />
                                <Border
                                    Width="24"
                                    Height="24"
                                    Margin="6,0,0,0"
                                    Background="{Binding CustomPreview[WarningBrush]}"
                                    CornerRadius="5" />
                                <Border
                                    Width="24"
                                    Height="24"
                                    Margin="6,0,0,0"
                                    Background="{Binding CustomPreview[ErrorBrush]}"
                                    CornerRadius="5" />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                <Button
                                    Command="{Binding SaveCustomThemeCommand}"
                                    Content="保存并应用"
                                    Style="{StaticResource PrimaryButton}" />
                                <Button
                                    Margin="10,0,0,0"
                                    Command="{Binding DeleteCustomThemeCommand}"
                                    Content="删除该主题"
                                    IsEnabled="{Binding CanDeleteCustomTheme}"
                                    Style="{StaticResource DangerButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  高级：逐项覆盖  -->
                <Expander
                    Margin="0,14,0,0"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Header="高级：逐项覆盖语义色（可选）">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock
                            Style="{StaticResource MutedText}"
                            Text="只对需要微调的颜色做覆盖；留空表示沿用按主色推导的颜色。支持 #RRGGBB，也支持 #AARRGGBB 控制透明度。" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <ComboBox
                                Width="220"
                                ItemsSource="{Binding BrushKeys}"
                                SelectedItem="{Binding SelectedBrushKey}" />
                            <TextBox
                                Width="120"
                                Margin="10,0,0,0"
                                materialDesign:HintAssist.Hint="#RRGGBB"
                                Style="{StaticResource DarkTextBox}"
                                Text="{Binding NewOverrideValue, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Margin="10,0,0,0"
                                Command="{Binding AddOverrideCommand}"
                                Content="添加覆盖"
                                Style="{StaticResource ControlButton}" />
                        </StackPanel>

                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding EditOverrides}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3" Orientation="Horizontal">
                                        <TextBlock
                                            Width="200"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Text="{Binding Key}" />
                                        <TextBox
                                            Width="120"
                                            Style="{StaticResource DarkTextBox}"
                                            Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                        <Border
                                            Width="22"
                                            Height="22"
                                            Margin="8,0,0,0"
                                            Background="{Binding Value}"
                                            CornerRadius="4" />
                                        <Button
                                            Margin="10,0,0,0"
                                            Command="{Binding DataContext.RemoveOverrideCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="移除"
                                            Style="{StaticResource DangerButton}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <TextBlock
            Margin="0,14,0,0"
            FontSize="13"
            Foreground="{DynamicResource PrimaryBrush}"
            Text="{Binding StatusText}" />
    </StackPanel>
</UserControl>
