<UserControl
    x:Class="MultiCameraSystem.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  页面头：标题 + 状态 + 操作  -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="系统设置" />
                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource MutedText}"
                    Text="{Binding StatusMessage, TargetNullValue='配置文件: appsettings.json'}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Command="{Binding ReloadCommand}"
                    Content="重新加载"
                    Style="{StaticResource ControlButton}" />
                <Button
                    Margin="0,0,8,0"
                    Command="{Binding ResetCommand}"
                    Content="恢复默认"
                    Style="{StaticResource DangerButton}" />
                <Button
                    Command="{Binding SaveCommand}"
                    Content="💾 保存"
                    Style="{StaticResource SuccessButton}" />
            </StackPanel>
        </Grid>

        <!-- 设置主体 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ===== 常规设置 ===== -->
                <Border Margin="0,0,0,10" Padding="16" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,14" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}" Text="常规设置" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="图像保存路径" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding ImageSavePath, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="日志路径" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding LogPath, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="日志保留天数" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
                                <CheckBox Margin="0,0,0,4" Content="启动时自动连接相机" FontSize="13"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          IsChecked="{Binding AutoStartCamera}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== 相机默认参数 ===== -->
                <Border Margin="0,0,0,10" Padding="16" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,14" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}" Text="相机默认参数" />
                        <UniformGrid Columns="3" Rows="2">
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="曝光时间 (μs)" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding ExposureTime, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="4,0,4,10">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="增益值 (dB)" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding GainValue, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,10">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="抓取超时 (ms)" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding GrabTimeout, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="缓冲区数量" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding BufferCount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="4,0,4,0">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="图像格式" />
                                <ComboBox Style="{StaticResource MaterialDesignComboBox}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Background="{DynamicResource SurfaceDarkBrush}"
                                          Text="{Binding ImageFormat, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="Bmp" />
                                    <ComboBoxItem Content="Jpeg" />
                                    <ComboBoxItem Content="Png" />
                                    <ComboBoxItem Content="Tiff" />
                                </ComboBox>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ===== PLC 设置 ===== -->
                <Border Margin="0,0,0,10" Padding="16" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,14" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}" Text="PLC 通信" />
                        <UniformGrid Columns="3" Rows="2">
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="IP 地址" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding PlcIp, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="4,0,4,10">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="端口" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding PlcPort, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,10">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="协议" />
                                <ComboBox Style="{StaticResource MaterialDesignComboBox}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Background="{DynamicResource SurfaceDarkBrush}"
                                          Text="{Binding PlcProtocol, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="ModbusTcp" />
                                    <ComboBoxItem Content="SiemensS7" />
                                    <ComboBoxItem Content="MitsubishiMC" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="连接超时 (ms)" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding PlcConnectTimeout, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="4,0,4,0">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="读写超时 (ms)" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding PlcReadWriteTimeout, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ===== MES 设置 ===== -->
                <Border Margin="0,0,0,10" Padding="16" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,14" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}" Text="MES 服务" />
                        <UniformGrid Columns="3" Rows="2">
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="服务器地址" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding MesUrl, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="4,0,4,10">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="API Key" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding MesApiKey, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,10">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="超时 (秒)" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding MesTimeout, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="产线编号" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding MesLineId, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="4,0,4,0">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="工站编号" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding MesStationId, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="最大重试次数" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding MesMaxRetries, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
