<UserControl
    x:Class="MultiCameraSystem.Views.RunView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attached="clr-namespace:HalconView.AttachedProperties;assembly=HalconView"
    xmlns:halconView="clr-namespace:HalconView;assembly=HalconView"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- 左侧主区域 -->
        <Grid Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  页面头：标题 + 说明 + 操作  -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="运行界面" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource MutedText}"
                        Text="{Binding Status}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding LoadImageCommand}"
                        Content="📂 加载图像"
                        Style="{StaticResource ControlButton}" />
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding SelectProgramCommand}"
                        Content="📁 选择程序"
                        Style="{StaticResource ControlButton}" />
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding RunDetectionCommand}"
                        Content="▶ 执行检测"
                        Style="{StaticResource SuccessButton}" />
                    <Button
                        Command="{Binding ClearRecordsCommand}"
                        Content="清空记录"
                        Style="{StaticResource DangerButton}" />
                </StackPanel>
            </Grid>

            <!-- 图像显示区 -->
            <Border Grid.Row="1" Padding="0" Background="{DynamicResource CanvasBrush}"
                    Style="{StaticResource CardBorder}">
                <halconView:HalconView
                    x:Name="HalconDisplay"
                    attached:HalconWindowAttachedProperties.WindowReadyCommand="{Binding WindowReadyCommand}"
                    HImage="{Binding CurrentImage, Mode=OneWay}" />
            </Border>
        </Grid>

        <!-- 右侧控制面板 -->
        <Border Grid.Column="1" Padding="14" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Margin="0,0,0,12" Style="{StaticResource SectionTitle}" Text="检测信息" />

                    <!-- 状态 -->
                    <TextBlock Style="{StaticResource MutedText}" Text="状态" />
                    <Border Margin="0,4,0,12" Padding="8,4" Background="{DynamicResource SurfaceDarkBrush}"
                            CornerRadius="4">
                        <TextBlock FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Status}" />
                    </Border>

                    <!-- 程序 -->
                    <TextBlock Style="{StaticResource MutedText}" Text="检测程序" />
                    <Border Margin="0,4,0,12" Padding="8,4" Background="{DynamicResource SurfaceDarkBrush}"
                            CornerRadius="4">
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding SelectedProgram, TargetNullValue='未选择'}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- 耗时 -->
                    <TextBlock Style="{StaticResource MutedText}" Text="耗时" />
                    <Border Margin="0,4,0,12" Padding="8,4" Background="{DynamicResource SurfaceDarkBrush}"
                            CornerRadius="4">
                        <TextBlock FontSize="14" FontWeight="SemiBold" FontFamily="Consolas"
                                   Foreground="{DynamicResource TextAccentBrush}"
                                   Text="{Binding ElapsedTime, TargetNullValue='--'}" />
                    </Border>

                    <!-- 检测结果 -->
                    <TextBlock Style="{StaticResource MutedText}" Text="检测结果" />
                    <Border Margin="0,4,0,12" Padding="8,4" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SurfaceDarkBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOk}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNg}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ErrorTintBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding DetectionResult, TargetNullValue='--'}" />
                    </Border>

                    <Separator Margin="0,8" Background="{DynamicResource CardBorderBrush}" />

                    <!-- 检测记录 -->
                    <TextBlock Margin="0,0,0,8" Style="{StaticResource SectionTitle}" Text="检测记录" />
                    <ItemsControl ItemsSource="{Binding Records}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,4" Padding="6,4"
                                        Background="{DynamicResource SurfaceDarkBrush}" CornerRadius="4">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="11" FontFamily="Consolas"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" />
                                            <TextBlock Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                                                       Text="{Binding Result}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding Display}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
