<UserControl
    x:Class="MultiCameraSystem.Views.LogViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:MultiCameraSystem.Behaviors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="LevelBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SecondaryTintBrush}" />
        </Style>

        <!--  日志级别配色：全部来自主题画刷，切换主题即时生效  -->
        <Style
            x:Key="LogLevelBadge"
            BasedOn="{StaticResource LevelBadge}"
            TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                    <Setter Property="Background" Value="{DynamicResource ErrorTintStrongBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="FATAL">
                    <Setter Property="Background" Value="{DynamicResource ErrorTintStrongBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="WARN">
                    <Setter Property="Background" Value="{DynamicResource WarningTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="INFO">
                    <Setter Property="Background" Value="{DynamicResource PrimaryTintBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogLevelText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="FATAL">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="WARN">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="INFO">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  工具栏  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,4"
            Padding="8,4"
            Style="{StaticResource CardBorder}">
            <Grid>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Kind="Text" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="系统日志" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{Binding LogEntries.Count, StringFormat='({0} 条)'}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <CheckBox
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Content="自动滚动"
                        FontSize="10"
                        Foreground="{DynamicResource TextMutedBrush}"
                        IsChecked="{Binding AutoScroll}" />
                    <Button
                        Width="56"
                        Height="24"
                        Padding="0"
                        Command="{Binding ClearCommand}"
                        Content="清空"
                        FontSize="10"
                        Style="{StaticResource DangerButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  过滤栏  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,3"
            Padding="6,4"
            Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  级别过滤 — 纯普通 ToggleButton  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ToggleButton
                        x:Name="BtnAll"
                        Width="80"
                        Height="22"
                        Margin="5"
                        Content="ALL"
                        FontSize="10"
                        IsChecked="{Binding IsFilterAll}"
                        Style="{DynamicResource MaterialDesignChoiceChipRadioButton}" />
                    <ToggleButton
                        x:Name="BtnErr"
                        Width="80"
                        Height="22"
                        Margin="5"
                        Content="ERR"
                        FontSize="10"
                        IsChecked="{Binding IsFilterError}"
                        Style="{DynamicResource MaterialDesignChoiceChipRadioButton}" />
                    <ToggleButton
                        x:Name="BtnWarn"
                        Width="80"
                        Height="22"
                        Margin="5"
                        Content="WARN"
                        FontSize="10"
                        IsChecked="{Binding IsFilterWarn}"
                        Style="{DynamicResource MaterialDesignChoiceChipRadioButton}" />
                    <ToggleButton
                        x:Name="BtnInfo"
                        Width="80"
                        Height="22"
                        Margin="5"
                        Content="INFO"
                        FontSize="10"
                        IsChecked="{Binding IsFilterInfo}"
                        Style="{DynamicResource MaterialDesignChoiceChipRadioButton}" />
                    <ToggleButton
                        x:Name="BtnDbg"
                        Width="80"
                        Height="22"
                        Margin="5"
                        Content="DEBUG"
                        FontSize="10"
                        IsChecked="{Binding IsFilterDebug}"
                        Style="{DynamicResource MaterialDesignChoiceChipRadioButton}" />
                </StackPanel>

                <!--  搜索框  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="12"
                        Height="12"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Kind="Magnify" />
                    <TextBox
                        Width="160"
                        Margin="6,0,0,0"
                        VerticalContentAlignment="Center"
                        CaretBrush="{DynamicResource PrimaryBrush}"
                        FontSize="12"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  日志列表  -->
        <ListBox
            x:Name="LogListBox"
            Grid.Row="2"
            Background="{DynamicResource CanvasBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            behaviors:ListBoxBehaviors.AutoScrollToEnd="{Binding AutoScroll}"
            ItemsSource="{Binding FilteredEntries}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
            VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="8,1"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LogLevelBadge}">
                                <TextBlock Style="{StaticResource LogLevelText}" Text="{Binding Level}" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="10"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}" />

                            <TextBlock
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="{Binding Message}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Message}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
