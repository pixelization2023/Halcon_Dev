<UserControl
    x:Class="MultiCameraSystem.Views.TestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attached="clr-namespace:HalconView.AttachedProperties;assembly=HalconView"
    xmlns:halconView="clr-namespace:HalconView;assembly=HalconView"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  页面头：标题 + 说明 + 操作  -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="流程测试" />
                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource MutedText}"
                    Text="加载单张图像与 HDevelop 程序，验证流程输出" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Command="{Binding LoadImageCommand}"
                    Content="📂 加载图像"
                    Style="{StaticResource ControlButton}" />
                <Button
                    Margin="0,0,8,0"
                    Command="{Binding Load_Hdev}"
                    Content="▶ 加载 Hdev"
                    Style="{StaticResource SuccessButton}" />
                <Button
                    Command="{Binding Load_Hdvp}"
                    Content="📦 加载 Hdvp"
                    Style="{StaticResource ControlButton}" />
            </StackPanel>
        </Grid>

        <!-- 图像显示区 -->
        <Border Grid.Row="1" Padding="0" Background="{DynamicResource CanvasBrush}"
                Style="{StaticResource CardBorder}">
            <halconView:HalconView
                x:Name="HalconDisplay"
                attached:HalconWindowAttachedProperties.WindowReadyCommand="{Binding WindowReadyCommand}"
                HImage="{Binding CurrentImage, Mode=OneWay}" />
        </Border>

        <!-- 底部状态 -->
        <Border Grid.Row="2" Margin="0,6,0,0" Padding="14,8" Style="{StaticResource CardBorder}">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextMutedBrush}" Text="状态:" />
                    <TextBlock VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding Status}" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                           Text="{Binding SelectedFile, TargetNullValue='未选择文件'}"
                           TextTrimming="CharacterEllipsis" MaxWidth="400" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
