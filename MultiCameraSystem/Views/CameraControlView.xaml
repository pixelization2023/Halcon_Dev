<UserControl
    x:Class="MultiCameraSystem.Views.CameraControlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:MultiCameraSystem.Convert"
    xmlns:halconView="clr-namespace:HalconView;assembly=HalconView"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent">

    <UserControl.Resources>
        <convert:InverseBooleanConverter x:Key="InverseBool" />
        <convert:BooleanAndConverter x:Key="BooleanAnd" />
        <convert:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部状态栏  -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="14,10" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Width="36" Height="36" Background="{DynamicResource PrimaryTintBrush}" CornerRadius="8">
                        <materialDesign:PackIcon Width="18" Height="18"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Foreground="{DynamicResource PrimaryBrush}" Kind="CameraIris" />
                    </Border>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Camera.Info.ModelName, TargetNullValue='未选择相机'}" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsGrabbing}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource GrabbingBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding Status, TargetNullValue='未连接'}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!--  帧率  -->
                <Border Grid.Column="2" Padding="12,6" Background="{DynamicResource SurfaceDarkBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryLightBrush}" Text="FPS" />
                        <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextAccentBrush}"
                                   Text="{Binding FrameRate, StringFormat={}{0:F1}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!--  中间主区域  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧参数面板  -->
            <Border Grid.Column="0" Margin="0,0,10,0" Padding="14" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,14" FontSize="14" Style="{StaticResource SectionTitle}"
                                   Text="参数设置" />

                        <TextBlock Margin="0,0,0,4" Style="{StaticResource MutedText}" Text="曝光时间 (μs)" />
                        <TextBox Margin="0,0,0,12" Style="{StaticResource DarkTextBox}"
                                 Text="{Binding ExposureTime, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,0,0,4" Style="{StaticResource MutedText}" Text="增益 (dB)" />
                        <TextBox Margin="0,0,0,16" Style="{StaticResource DarkTextBox}"
                                 Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Width="Auto" Margin="0,0,0,20" Command="{Binding SaveconfigCommand}"
                                Content="💾 保存参数" Style="{StaticResource PrimaryButton}">
                            <Button.IsEnabled>
                                <MultiBinding Converter="{StaticResource BooleanAnd}">
                                    <Binding Path="IsConnected" />
                                    <Binding Path="IsGrabbing" Converter="{StaticResource InverseBool}" />
                                </MultiBinding>
                            </Button.IsEnabled>
                        </Button>

                        <Separator Margin="0,0,0,16" Background="{DynamicResource CardBorderBrush}" />

                        <TextBlock Margin="0,0,0,12" FontSize="14" Style="{StaticResource SectionTitle}"
                                   Text="触发模式" />

                        <Button Margin="0,0,0,8" Content="📷 连续采集"
                                Style="{StaticResource ControlButton}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Background="{DynamicResource SurfaceDarkBrush}"
                                Command="{Binding SetContinuousModeCommand}">
                            <Button.IsEnabled>
                                <MultiBinding Converter="{StaticResource BooleanAnd}">
                                    <Binding Path="IsConnected" />
                                    <Binding Path="IsGrabbing" Converter="{StaticResource InverseBool}" />
                                </MultiBinding>
                            </Button.IsEnabled>
                        </Button>

                        <Button Margin="0,0,0,8" Content="⚡ 软件触发"
                                Style="{StaticResource ControlButton}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Background="{DynamicResource SurfaceDarkBrush}"
                                Command="{Binding SetSoftwareTriggerModeCommand}">
                            <Button.IsEnabled>
                                <MultiBinding Converter="{StaticResource BooleanAnd}">
                                    <Binding Path="IsConnected" />
                                    <Binding Path="IsGrabbing" Converter="{StaticResource InverseBool}" />
                                </MultiBinding>
                            </Button.IsEnabled>
                        </Button>

                        <Button Margin="0,0,0,16" Content="🔌 硬触发 Line1"
                                Style="{StaticResource ControlButton}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Background="{DynamicResource SurfaceDarkBrush}"
                                Command="{Binding SetHardwareTriggerModeCommand}">
                            <Button.IsEnabled>
                                <MultiBinding Converter="{StaticResource BooleanAnd}">
                                    <Binding Path="IsConnected" />
                                    <Binding Path="IsGrabbing" Converter="{StaticResource InverseBool}" />
                                </MultiBinding>
                            </Button.IsEnabled>
                        </Button>

                        <Separator Margin="0,0,0,16" Background="{DynamicResource CardBorderBrush}" />

                        <Button Width="Auto" Margin="0,0,0,16" Content="▶ 执行软触发"
                                Style="{StaticResource SuccessButton}"
                                Command="{Binding ExecuteSoftwareTriggerCommand}">
                            <Button.IsEnabled>
                                <MultiBinding Converter="{StaticResource BooleanAnd}">
                                    <Binding Path="IsConnected" />
                                    <Binding Path="IsGrabbing" />
                                </MultiBinding>
                            </Button.IsEnabled>
                        </Button>

                        <Button Content="📸 拍照保存" Style="{StaticResource ControlButton}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Background="{DynamicResource SurfaceDarkBrush}"
                                Command="{Binding CaptureCommand}">
                            <Button.IsEnabled>
                                <MultiBinding Converter="{StaticResource BooleanAnd}">
                                    <Binding Path="IsConnected" />
                                    <Binding Path="IsGrabbing" />
                                </MultiBinding>
                            </Button.IsEnabled>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  中央图像显示区  -->
            <Border Grid.Column="1" Padding="0" Background="{DynamicResource CanvasBrush}"
                    Style="{StaticResource CardBorder}">
                <Grid>
                    <halconView:HalconView x:Name="HalconDisplay" HImage="{Binding Hobjeimage, Mode=OneWay}" />

                    <Border Background="{DynamicResource ScrimBrush}" CornerRadius="8"
                            Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Width="64" Height="64"
                                Foreground="{DynamicResource TextMutedBrush}" Kind="ImageOffOutline" />
                            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="16"
                                       Foreground="{DynamicResource TextMutedBrush}" Text="等待图像采集..." />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  底部控制栏  -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="14,10" Style="{StaticResource CardBorder}">
            <WrapPanel HorizontalAlignment="Center">
                <!--  连接相机: IsConnected=false  -->
                <Button Margin="4" Content="🔗 连接相机" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ConnectCommand}"
                        IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBool}}" />

                <!--  断开连接: IsConnected=true  -->
                <Button Margin="4" Content="❌ 断开连接" Style="{StaticResource DangerButton}"
                        Command="{Binding DisconnectCommand}"
                        IsEnabled="{Binding IsConnected}" />

                <Separator Width="2" Height="24" Margin="12,4"
                           Style="{StaticResource MaterialDesignSeparator}" />

                <!--  开始采集: IsConnected=true AND IsGrabbing=false  -->
                <Button Margin="4" Content="▶ 开始采集" Style="{StaticResource SuccessButton}"
                        Command="{Binding StartGrabbingCommand}">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource BooleanAnd}">
                            <Binding Path="IsConnected" />
                            <Binding Path="IsGrabbing" Converter="{StaticResource InverseBool}" />
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>

                <!--  停止采集: IsConnected=true AND IsGrabbing=true  -->
                <Button Margin="4" Content="⏹ 停止采集" Style="{StaticResource DangerButton}"
                        Background="{DynamicResource WarningBrush}"
                        Command="{Binding StopGrabbingCommand}">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource BooleanAnd}">
                            <Binding Path="IsConnected" />
                            <Binding Path="IsGrabbing" />
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
